// Generated by bin/gms.exe rooms in workspace/art/gms_map. Rerun the tool instead of editing by hand.
// Each template is whole cells in size and loads at its bottom left cell corner.
/datum/map_template/random_room/gms
	room_type = "gms"
	stock = 999
	keep_cached_map = TRUE
	/// Key of GLOB.gms_room_shapes this template fills.
	var/shape = "1x1"

